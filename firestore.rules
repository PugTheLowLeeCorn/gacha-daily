rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validDateKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      match /games/{gameId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /dailyLogs/{logId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.gameId is string
          && validDateKey(request.resource.data.date)
          && request.resource.data.status in ['completed', 'skipped']
          && logId == request.resource.data.date + '_' + request.resource.data.gameId;
        allow delete: if false;
      }

      match /reminderLogs/{date} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
